---
interface Props {
	date: Date;
	lang?: string;
}

const { date, lang = 'en' } = Astro.props;
const locale = lang === 'ja' ? 'ja-JP' : 'en-US';
---

<time datetime={date.toISOString()}>
	{
		date.toLocaleDateString(locale, {
			year: 'numeric',
			month: 'short',
			day: '2-digit',
		})
	}
</time>
