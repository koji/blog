---
import Author from '../Author.astro';
import { useTranslations, type Lang } from '@src/i18n/utils';

interface Props {
	lang?: Lang;
}
const { lang = 'en' } = Astro.props as Props;
const t = useTranslations(lang);
---

<div class='about-the-author py-4 border-b border-black/10 dark:border-white/10'>
	<h3 class='font-semibold uppercase mb-4 text-xs text-black/48 dark:text-white/48 tracking-[-0.12px]'>{t('widget.aboutAuthor.title')}</h3>
	<Author picSize='md' />
	<div class='text-[14px] my-4 text-black/80 dark:text-white/80 leading-[1.43] tracking-[-0.224px]'>
		<p class='mb-3'>
			{t('widget.aboutAuthor.body1', { topics: t('widget.aboutAuthor.topics') })}
		</p>
		<p>
			{t('widget.aboutAuthor.body2')}
		</p>
	</div>
</div>
