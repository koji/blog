---
import { slugify } from '../utils';
import FormattedDate from './FormattedDate.astro';
import type { CollectionEntry } from 'astro:content';
import { getLangFromId, getLocalizedPath, getBaseSlug } from '@src/i18n/utils';

type BlogPost = CollectionEntry<'blog'>;
const { post, lang: propLang }: Record<string, any> | { post: BlogPost; lang?: string } = Astro.props
const lang = propLang ?? getLangFromId(post.id);
const baseSlug = getBaseSlug(post);
const postUrl = getLocalizedPath(`/${baseSlug}/`, lang as 'en' | 'ja');
---
<div class='flex flex-col sm:flex-row gap-2 sm:items-center border-b border-black/10 dark:border-white/10 py-3 mb-1 capitalize group transition-colors'>
  <div class='text-black/48 dark:text-white/48 text-sm w-24 shrink-0 tracking-[-0.224px]'>
    <FormattedDate date={post.data.pubDate} lang={lang} />
  </div>
  <h3 class='font-semibold grow text-apple-near-black dark:text-white group-hover:text-apple-link-blue dark:group-hover:text-apple-bright-blue transition-colors tracking-[-0.374px]'>
    <a href={postUrl}>
      {post.data.title}
    </a>
  </h3>
  <div class='flex gap-2 shrink-0'>
    {
      (post.data.tags || [] )?.map((tag: string) => (
        <a
          class='tag-apple'
          href={getLocalizedPath(`/tags/${slugify(tag)}/`, lang as 'en' | 'ja')}>
          {tag}
        </a>
      ))
    }
  </div>
</div>
