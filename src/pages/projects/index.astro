---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectList from '../../components/ProjectList.astro';
import { projects } from './projects';
import { useTranslations } from '@src/i18n/utils';

const lang = 'en' as const;
const t = useTranslations(lang);
---

<BaseLayout
	title={t('page.projects.title')}
	description={t('page.projects.description')}
	lang={lang}
>
  <div class='container'>
    <div class="mb-10">
      <h1 class="text-[40px] font-semibold mb-2 text-apple-near-black dark:text-white leading-[1.10] tracking-[-0.28px]">{t('page.projects.title')}</h1>
      <p class="text-black/80 dark:text-white/80 text-[17px] leading-[1.47] tracking-[-0.374px]">{t('page.projects.description')}</p>
    </div>
    <ProjectList projects={projects}/>
  </div>
</BaseLayout>
