---
import { languages, getLocalizedPath, type Lang } from '@src/i18n/utils';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const currentPath = Astro.url.pathname;
const otherLang: Lang = lang === 'en' ? 'ja' : 'en';
const switchHref = getLocalizedPath(currentPath, otherLang);
---

<a
	href={switchHref}
	class='px-2.5 py-1.5 text-xs font-medium rounded-full border border-black/10 dark:border-white/10 hover:bg-black/5 dark:hover:bg-white/10 transition-colors'
	aria-label={`Switch to ${languages[otherLang]}`}
>
	<span class='hidden sm:inline'>{languages[otherLang]}</span>
	<span class='sm:hidden'>{otherLang.toUpperCase()}</span>
</a>
